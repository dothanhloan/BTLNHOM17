<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="12dp"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@android:color/white" android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/txtTenPhim"
        android:text="Tên phim"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/txtChiTiet"
        android:text="Chi tiết vé"
        android:textSize="14sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/txtTien"
        android:text="Tổng tiền"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        android:textStyle="bold"
        android:textColor="#FF5722"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
