<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".admin.AddEditScreeningActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">


        <TextView
            android:id="@+id/tvAddEditScreeningTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thêm Lịch Chiếu Mới"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp"
            android:layout_marginTop="24dp"
            android:textColor="@android:color/black"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chọn Phim:"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>
        <Spinner
            android:id="@+id/spinnerScreeningMovie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:minHeight="48dp"
            android:spinnerMode="dropdown"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chọn Phòng:"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>
        <Spinner
            android:id="@+id/spinnerScreeningRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:minHeight="48dp"
            android:spinnerMode="dropdown"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ngày chiếu:"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>
        <Button
            android:id="@+id/btnPickDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chọn Ngày"
            android:padding="12dp"
            android:textSize="16sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thời gian chiếu:"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>
        <Button
            android:id="@+id/btnPickTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chọn Giờ"
            android:padding="12dp"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/tvSelectedDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thời gian đã chọn: "
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnSaveScreening"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lưu Lịch Chiếu"
            android:padding="12dp"
            android:textSize="18sp"/>

    </LinearLayout>
</ScrollView>