<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvScreeningMovieName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên Phim: Godzilla x Kong"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"/>

            <TextView
                android:id="@+id/tvScreeningRoomNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phòng: P1"
                android:textSize="14sp"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tvScreeningStartTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thời gian chiếu: 26/07/2024 19:30"
                android:textSize="14sp"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="16dp">

            <Button
                android:id="@+id/btnEditScreening"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sửa"
                android:textSize="12sp"
                android:padding="8dp"/>

            <Button
                android:id="@+id/btnDeleteScreening"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xóa"
                android:textSize="12sp"
                android:padding="8dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@android:color/holo_red_light"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>