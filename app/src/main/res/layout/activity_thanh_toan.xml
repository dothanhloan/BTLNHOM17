<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- TextView để code tham chiếu đến txtChiTiet -->
        <TextView
            android:id="@+id/txtChiTiet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bạn cần thanh toán: 0đ"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:textColor="#000000"/>

        <!-- Tiêu đề phần Thanh toán -->
        <TextView
            android:text="Thanh toán vé xem phim"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- THÔNG TIN PHIM -->
        <TextView
            android:text="THÔNG TIN PHIM"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"
            android:textColor="#444444"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Các dòng thông tin phim -->
        <TextView android:text="Tên phim: BÍ KÍP LUYỆN RỒNG (K)"
            style="@style/TextRow" />
        <!-- ... các TextView style TextRow khác ... -->

        <!-- THÔNG TIN NHẬN VÉ -->
        <TextView
            android:text="THÔNG TIN NHẬN VÉ"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:textColor="#444444"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="Thông tin vé sẽ được gửi tới email hoặc hiển thị trong ứng dụng."
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />



        <!-- MÃ QR THANH TOÁN -->
        <TextView
            android:text="Quét mã QR để thanh toán"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#444444"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <ImageView
            android:id="@+id/imgQR"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:src="@drawable/qr_thanhtoan"
            android:contentDescription="QR Thanh toán" />

        <!-- Nút xác nhận -->
        <Button
            android:id="@+id/btnXacNhan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Xác nhận thanh toán"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"
            android:layout_marginTop="24dp"
            android:textSize="18sp"/>
    </LinearLayout>
</ScrollView>
