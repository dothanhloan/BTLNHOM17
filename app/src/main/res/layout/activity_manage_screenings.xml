<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".admin.ManageScreeningsActivity">

    <TextView
        android:id="@+id/tvManageScreeningsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quản lý Lịch Chiếu"
        android:textSize="24sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:gravity="center"
        android:background="@color/material_dynamic_primary0"
        android:textColor="@android:color/white"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewScreenings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tvManageScreeningsTitle"
        android:layout_above="@+id/btnAddScreening"
        android:padding="8dp"
        android:scrollbars="vertical" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnAddScreening"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:clickable="true"
        android:focusable="true"
        android:src="@android:drawable/ic_input_add"
        android:contentDescription="Thêm Lịch Chiếu Mới" />

</RelativeLayout>